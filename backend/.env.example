# ─────────────────────────────────────────────────────────────────────────────
# NLP Research Analyzer — Environment Variables
# Copy this file to .env and fill in your values before running the app.
# Never commit your actual .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB (Required) ────────────────────────────────────────────────────────
# Local MongoDB (default, no sign-up needed):
#   MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas free tier (recommended for production):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Get a free Atlas cluster at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb://localhost:27017

# Name of the database to use (will be created automatically if it doesn't exist)
MONGODB_DB_NAME=nlp_research

# ── LLM (Required for Agentic Research) ──────────────────────────────────────
# Powers the Planner, Synthesizer, and Reviewer agent nodes via Groq
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Web Search (Required for Agentic Research) ────────────────────────────────
# Powers real-time web search in the Researcher node
# Get a free key at: https://app.tavily.com/
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# CRITICAL: Change this in production! Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_hex_string_in_production

# ── CORS (Frontend Origin) ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your deployed frontend URL here when going to production.
# Example: FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Redis (Optional) ──────────────────────────────────────────────────────────
# Leave empty to disable Redis caching (default).
# REDIS_URL=redis://localhost:6379

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# The public URL of your backend API. Used by the React frontend.
# Change to your deployed backend URL in production.
# Example: VITE_API_URL=https://your-api.railway.app/api
VITE_API_URL=http://localhost:8000/api
